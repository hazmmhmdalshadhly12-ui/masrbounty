# MasrBounty Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub!

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MasrBounty
NEXT_PUBLIC_APP_DESCRIPTION=منصة Bug Bounty مصرية احترافية

# Authentication
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Email (Optional - for production)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@masrbounty.com

# Storage
NEXT_PUBLIC_STORAGE_URL=

# Webhooks (server-to-server; shared secret compared timing-safe)
# Set the same value in Supabase Dashboard → Webhooks / Edge secrets.
SUPABASE_WEBHOOK_SECRET=

# Analytics (Optional)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_RTL=true
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Rate Limiting (Optional - for production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Webhooks (Optional)
# STRIPE_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET=

# Development
NODE_ENV=development
# ============================================================
# AI (Platform-wide — set these in Cloudflare Pages → Settings →
# Environment variables AND locally in .env.local. NEVER prefix
# with NEXT_PUBLIC: the key must stay server-side only.)
# Any OpenAI-compatible provider works (base URL must include the
# version path, e.g. https://api.openai.com/v1).
# ============================================================
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Max characters per AI request body (soft abuse bound)
AI_MAX_INPUT_CHARS=12000
